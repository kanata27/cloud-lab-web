{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanata-web-preview",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/earnings-api/*"
    ]
  },
  "routes": [
    {
      "pattern": "preview.kanata27.com",
      "custom_domain": true
    }
  ],
  "main": "worker/earnings.js",
  "d1_databases": [
    {
      "binding": "EARNINGS_DB",
      "database_name": "kanata-earnings-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
