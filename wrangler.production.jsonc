{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanata-web",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/",
      "!/index.html",
      "!/style.css",
      "!/analytics.js",
      "!/site-config.js",
      "!/assets/apple-touch-icon.png",
      "!/assets/favicon.ico",
      "!/assets/favicon.svg",
      "!/assets/hero.webp",
      "!/assets/kanata-logo.svg",
      "!/assets/og-image.jpg",
      "!/robots.txt",
      "!/404.html"
    ]
  },
  "routes": [
    {
      "pattern": "kanata27.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kanata27.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.js",
  "d1_databases": [
    {
      "binding": "EARNINGS_DB",
      "database_name": "kanata-earnings-production",
      "database_id": "8bfb46ec-55d4-43e0-85fc-47fcb67f927a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CANONICAL_HOST": "kanata27.com",
    "PUBLIC_ALIASES": "www.kanata27.com",
    "ACCESS_TEAM_DOMAIN": "https://purple-voice-fdcb.cloudflareaccess.com",
    "ACCESS_AUD": "ed32f8f8b3595fb4dee1ff74a4f224b61f9ef3cead6fc7eaa2d4a1d2ee6934dc"
  },
  "ratelimits": [
    {
      "name": "EVENTS_RATE_LIMITER",
      "namespace_id": "27102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
