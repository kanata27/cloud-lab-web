{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanata-web",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/earnings-api/*"
    ]
  },
  "routes": [
    {
      "pattern": "kanata27.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kanata27.com",
      "custom_domain": true
    }
  ],
  "main": "worker/earnings.js",
  "d1_databases": [
    {
      "binding": "EARNINGS_DB",
      "database_name": "kanata-earnings-production",
      "database_id": "8bfb46ec-55d4-43e0-85fc-47fcb67f927a",
      "migrations_dir": "migrations"
    }
  ]
}
