{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanata-web",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kanata27.com", "custom_domain": true },
    { "pattern": "www.kanata27.com", "custom_domain": true }
  ]
}
